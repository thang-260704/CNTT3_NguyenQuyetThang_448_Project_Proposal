# Sao chép thành .env nếu muốn đổi cấu hình (không bắt buộc - mặc định đã chạy được)
MYSQL_ROOT_PASSWORD=root123
DB_USERNAME=quickshop
DB_PASSWORD=quickshop123
JWT_SECRET=quickshop-docker-secret-key-please-change-in-production-2026
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# AI (tùy chọn). Để "none" -> dùng chế độ fallback nội bộ, không cần Internet.
# Có key OpenAI: AI_API_KEY=sk-...
# Dùng Gemini (OpenAI-compatible): AI_BASE_URL=https://generativelanguage.googleapis.com
#   AI_COMPLETIONS_PATH=/v1beta/openai/chat/completions  AI_MODEL=gemini-2.0-flash
AI_API_KEY=none
AI_BASE_URL=https://api.openai.com
AI_COMPLETIONS_PATH=/v1/chat/completions
AI_MODEL=gpt-4o-mini
